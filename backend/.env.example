# --- OpenAI (답변 생성) ---
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 답변 생성 모델. 기본값은 저비용 gpt-4o-mini. 품질 우선이면 gpt-4o로 교체.
OPENAI_MODEL=gpt-4o-mini

# --- Voyage AI (한국어 지원 임베딩) ---
# 발급: https://dashboard.voyageai.com/ (무료 크레딧 제공)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2

# --- Supabase (pgvector 포함 DB) ---
# 발급: https://supabase.com/dashboard -> 새 프로젝트 -> Project Settings -> API
# SUPABASE_URL은 "https://<project-ref>.supabase.co" 형태 (대시보드 페이지 주소가 아님)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 서버 ---
PORT=8787

# 검색 결과 중 이 유사도 미달이면 "근거 없음" 처리 (환각 가드의 핵심)
SIMILARITY_THRESHOLD=0.5
MATCH_COUNT=5
`